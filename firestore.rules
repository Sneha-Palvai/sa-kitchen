rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these two accounts can use S&A Kitchen.
    // Replace the two IDs below with the user IDs shown in the app.
    function isMember() {
      return request.auth != null && request.auth.uid in [
        'PASTE_FIRST_USER_ID_HERE',
        'PASTE_SECOND_USER_ID_HERE'
      ];
    }

    match /households/main/{document=**} {
      allow read, write: if isMember();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
